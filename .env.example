# Copy this file to .env and fill in your real values. Never commit .env.
# Get these from https://www.kaggle.com/settings -> API -> Create New Token
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# Kaggle dataset/kernel slugs this pipeline will create/update
KAGGLE_DATASET_SLUG=your_kaggle_username/voidvideo-anime-clips
KAGGLE_KERNEL_SLUG=your_kaggle_username/voidvideo-lora-train

# Which task to train: t2v or i2v (see README for why these use different base checkpoints)
TRAIN_TASK=t2v
