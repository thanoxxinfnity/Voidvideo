# Copy to .env.local for local `vercel dev` testing.
# In production, set these in the Vercel dashboard instead (Project -> Settings -> Environment Variables) --
# never commit real values here.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Powers the Smart Upload tab's AI category detection (api/classify.js).
# Get a free key at https://build.nvidia.com (account settings -> API Keys).
NVIDIA_API_KEY=your_nvapi_key
