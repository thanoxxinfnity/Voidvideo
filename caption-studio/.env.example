# Copy this file to .env in this folder and fill in your real token.
# Get a token at https://huggingface.co/settings/tokens (read access is enough).
# Never commit .env with a real value -- it's gitignored, keep it that way.
HF_TOKEN=hf_your_token_here

# Optional override. Qwen2-VL-7B-Instruct itself has no hosted inference
# provider, and Qwen2.5-VL-7B-Instruct's only provider (featherless-ai) is
# often at capacity on the free tier. Qwen2.5-VL-72B-Instruct via ovhcloud is
# the verified-working default -- change this if your HF account has a
# different provider enabled that you'd rather use.
HF_CAPTION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct:ovhcloud
